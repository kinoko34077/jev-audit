{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinotch.local/schema/defaults.schema.json",
  "title": "KiNoTch Default Pack State",
  "type": "object",
  "required": [
    "schema_version",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "packs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "OVERRIDE",
              "DISABLED"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
